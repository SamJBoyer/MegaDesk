#!/usr/bin/env bash
# Thin wrapper: always run the Python refresher so nested nodes (Factory/) are included.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python >/dev/null 2>&1; then
    exec python "$SCRIPT_DIR/refresh_nodes.py"
fi

echo "error: python not on PATH; activate MEGADESK and run: python scripts/refresh_nodes.py" >&2
exit 1
